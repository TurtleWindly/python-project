<InputForm@BoxLayout>:
    label_text: ""
    text_input: text_input

    orientation: "vertical"

    Label:
        text: root.label_text
        font_size: 24
        size_hint_y: None

    TextInput:
        id: text_input
        multiline: False
        font_size: 32
        size_hint_y: None
        height: self.minimum_height
        padding_y: [10, 10]
