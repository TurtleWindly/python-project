{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Kivy App",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "KIVY_NO_CONSOLELOG": "1" // tắt spam log của Kivy nếu muốn
            }
        }
    ]
}
